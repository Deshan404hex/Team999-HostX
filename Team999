<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Team999 Hostx</title>

<style>
*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial, Helvetica, sans-serif;
}

body{
background:#0b0b0b;
color:white;
scroll-behavior:smooth;
}

header{
background:#111;
padding:15px 10%;
display:flex;
justify-content:space-between;
align-items:center;
position:sticky;
top:0;
z-index:1000;
}

.logo{
font-size:22px;
font-weight:bold;
color:#ff2a2a;
}

nav ul{
display:flex;
list-style:none;
}

nav ul li{
margin-left:20px;
}

nav ul li a{
text-decoration:none;
color:white;
font-size:15px;
transition:0.3s;
}

nav ul li a:hover{
color:#ff2a2a;
}

.menu-btn{
display:none;
font-size:25px;
cursor:pointer;
}

/* Hero */

.hero{
height:90vh;
display:flex;
flex-direction:column;
justify-content:center;
align-items:center;
text-align:center;
padding:20px;
}

.hero h1{
font-size:45px;
color:#ff2a2a;
}

.hero p{
margin:15px 0;
font-size:18px;
}

.btn{
background:#ff2a2a;
border:none;
padding:12px 25px;
color:white;
margin:10px;
cursor:pointer;
border-radius:5px;
transition:0.3s;
}

.btn:hover{
background:#cc0000;
}

/* Sections */

section{
padding:70px 10%;
text-align:center;
}

.section-title{
font-size:32px;
margin-bottom:40px;
color:#ff2a2a;
}

/* Cards */

.cards{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
gap:25px;
}

.card{
background:#141414;
padding:25px;
border-radius:10px;
transition:0.3s;
}

.card:hover{
transform:translateY(-5px);
}

.price{
font-size:30px;
margin:10px 0;
color:#ff2a2a;
}

.card ul{
list-style:none;
margin:15px 0;
}

.card ul li{
margin:6px 0;
}

/* Game Hosting */

.game{
background:#111;
padding:50px;
border-radius:10px;
}

/* Contact */

.contact form{
max-width:500px;
margin:auto;
display:flex;
flex-direction:column;
}

.contact input,
.contact textarea{
margin:10px 0;
padding:12px;
border:none;
border-radius:5px;
}

footer{
background:#111;
text-align:center;
padding:20px;
margin-top:40px;
}

/* Mobile */

@media(max-width:768px){

nav ul{
position:absolute;
top:60px;
left:0;
width:100%;
background:#111;
flex-direction:column;
display:none;
}

nav ul.show{
display:flex;
}

nav ul li{
margin:15px 0;
text-align:center;
}

.menu-btn{
display:block;
}

}
</style>

</head>

<body>

<header>
<div class="logo">Team999 Hostx</div>

<nav>
<ul id="menu">
<li><a href="#home">Home</a></li>
<li><a href="#plans">Hosting</a></li>
<li><a href="#vps">VPS</a></li>
<li><a href="#game">Game</a></li>
<li><a href="#about">About</a></li>
<li><a href="#contact">Contact</a></li>
</ul>
</nav>

<div class="menu-btn" onclick="toggleMenu()">☰</div>
</header>

<!-- Home -->

<section class="hero" id="home">
<h1>Team999 Hostx - Fast & Reliable Hosting</h1>
<p>Web Hosting, VPS, and SA-MP Game Servers</p>

<button class="btn">Get Started</button>
<button class="btn">View Plans</button>
</section>

<!-- Hosting Plans -->

<section id="plans">
<h2 class="section-title">Hosting Plans</h2>

<div class="cards">

<div class="card">
<h3>Starter Plan</h3>
<div class="price">$3/month</div>
<ul>
<li>10GB Storage</li>
<li>50GB Bandwidth</li>
<li>Free SSL</li>
<li>24/7 Support</li>
</ul>
<button class="btn">Order</button>
</div>

<div class="card">
<h3>Pro Plan</h3>
<div class="price">$7/month</div>
<ul>
<li>50GB Storage</li>
<li>Unlimited Bandwidth</li>
<li>Free SSL</li>
<li>24/7 Support</li>
</ul>
<button class="btn">Order</button>
</div>

<div class="card">
<h3>Ultimate Plan</h3>
<div class="price">$12/month</div>
<ul>
<li>Unlimited Storage</li>
<li>Unlimited Bandwidth</li>
<li>Free SSL</li>
<li>24/7 Support</li>
</ul>
<button class="btn">Order</button>
</div>

</div>
</section>

<!-- VPS -->

<section id="vps">
<h2 class="section-title">VPS Hosting</h2>
<p>High performance VPS servers with full root access and powerful hardware for developers and businesses.</p>
</section>

<!-- Game Hosting -->

<section id="game">
<h2 class="section-title">Game Hosting</h2>

<div class="game">
<h3>SA-MP Server Hosting</h3>
<p>Low ping SA-MP game servers with high performance hardware. Perfect for Roleplay, Freeroam and custom servers.</p>
<button class="btn">Order Game Server</button>
</div>

</section>

<!-- About -->

<section id="about">
<h2 class="section-title">About Us</h2>
<p>
Team999 Hostx is a modern hosting service providing fast web hosting, VPS servers and SA-MP game hosting.
Our mission is to deliver powerful servers with reliable uptime for developers and gaming communities.
</p>
</section>

<!-- Contact -->

<section id="contact" class="contact">
<h2 class="section-title">Contact Us</h2>

<form>
<input type="text" placeholder="Your Name" required>
<input type="email" placeholder="Your Email" required>
<textarea rows="5" placeholder="Your Message"></textarea>
<button class="btn">Send Message</button>
</form>

</section>

<footer>
<p>© 2026 Team999 Hostx | All Rights Reserved</p>
</footer>

<script>

function toggleMenu(){
document.getElementById("menu").classList.toggle("show");
}

</script>

</body>
</html>
